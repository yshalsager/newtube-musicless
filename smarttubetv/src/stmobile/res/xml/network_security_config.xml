<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keeps android:usesCleartextTraffic="true" (main manifest): a config overrides that flag. -->
    <base-config cleartextTrafficPermitted="true" />
    <!-- GitHub release files (music models, update check) chain to ISRG Root X1, which Android 7.0
         lacks (added in 7.1.1). Adds it for those hosts only, next to the system roots. -->
    <domain-config>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>
</network-security-config>
