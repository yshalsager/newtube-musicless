// Identity and version settings for the Musicless app target, all configurations.
// Structural settings (Swift version, device family, deployment target) live in project.yml.
//
// Your own values go in Local.xcconfig (gitignored; bootstrap.sh creates it from
// Local.xcconfig.example). Never commit a Team ID.

// Defaults that build for the simulator without a Local.xcconfig.
BUNDLE_ID_PREFIX = io.github.example
DEVELOPMENT_TEAM =
PAID_TEAM = NO

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).musicless

// Where the voice models are downloaded from (Info.plist MusiclessModelBaseURL; Android's
// musiclessModelBaseUrl). `$()` keeps xcconfig from reading "//" as a comment. Empty = none.
MUSICLESS_MODEL_BASE_URL = https:/$()/github.com/yshalsager/newtube-musicless/releases/download/musicless-models-v1
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic

// Capabilities a free Personal Team may not sign live behind PAID_TEAM (see Paid.xcconfig).
#include "Paid.xcconfig"

// Last, so it overrides everything above.
#include? "Local.xcconfig"
